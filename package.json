{
  "name": "vai-studio",
  "version": "1.0.2",
  "description": "VAI Studio - Test and compare Speech-to-Text models locally",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "electron electron/main.js",
    "dev": "./scripts/dev.sh",
    "dev:react": "vite",
    "build:react": "vite build && node scripts/check-react-bundle.js",
    "preview": "vite preview",
    "bundle:electron": "./scripts/bundle-electron.sh",
    "check:deps": "node scripts/check-dependencies.js",
    "check:react": "node scripts/check-react-bundle.js",
    "check:pnpm": "node scripts/validate-pnpm-config.js",
    "copy:deps": "node scripts/copy-dependencies.js",
    "prebuild": "node scripts/validate-pnpm-config.js && ./scripts/generate-build-info.sh && ./scripts/prepare-python-bundle.sh && npm run bundle:electron && npm run check:deps",
    "build": "npm run build:react && npm run prebuild && electron-builder",
    "build:mac": "npm run build:react && npm run prebuild && electron-builder --mac",
    "build:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:mac",
    "build:win": "npm run build:react && npm run prebuild && electron-builder --win",
    "build:linux": "npm run build:react && npm run prebuild && electron-builder --linux",
    "build:all": "npm run build:react && npm run prebuild && electron-builder --mac --win --linux",
    "smoke-test": "./scripts/smoke-test.sh",
    "release:mac": "./scripts/release-upload.sh mac",
    "release:win": "./scripts/release-upload.sh win",
    "release:linux": "./scripts/release-upload.sh linux",
    "release:all": "./scripts/release-upload.sh all",
    "release:mac:dry": "./scripts/release-upload.sh mac --dry-run",
    "verify:gatekeeper": "./scripts/verify-gatekeeper.sh",
    "verify:artifacts": "node scripts/verify-artifacts.js",
    "verify:build": "node scripts/validate-pnpm-config.js && node scripts/check-dependencies.js && node scripts/check-react-bundle.js",
    "verify:all": "npm run verify:build && npm run verify:artifacts",
    "clean": "rm -rf dist dist-electron dist-react node_modules/.cache",
    "clean:all": "rm -rf dist dist-electron dist-react node_modules"
  },
  "keywords": [
    "speech-to-text",
    "whisper",
    "voxtral",
    "transcription",
    "electron",
    "ai",
    "stt",
    "transcription-tool"
  ],
  "author": "VAI Studio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oddcommunity/VAI-Studio"
  },
  "build": {
    "appId": "com.vaistudio.app",
    "productName": "VAI Studio",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "protocols": {
      "name": "VAI Studio Protocol",
      "schemes": [
        "vai-studio"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/*.node",
      "backends-bundle/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "dist-electron/**/*",
      "dist-react/**/*",
      "backends/**/*.py",
      "!backends/__pycache__",
      "!backends/*.pyc"
    ],
    "extraResources": [
      {
        "from": "backends-bundle",
        "to": "backends",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      },
      {
        "from": "scripts/python-wrapper.sh",
        "to": "scripts/python-wrapper.sh"
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "type": "distribution",
      "signIgnore": [
        "venv/.*\\.pyc$",
        "venv/.*__pycache__"
      ]
    },
    "afterPack": "scripts/afterPack.js",
    "afterSign": "scripts/notarize.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.odd.community/releases/vai-studio"
    }
  },
  "dependencies": {
    "@odd-core/api": "workspace:*",
    "@odd-core/auth": "workspace:*",
    "@odd-core/log": "workspace:*",
    "@odd-core/storage": "workspace:*",
    "@odd-core/types": "workspace:*",
    "@odd-core/ui": "workspace:*",
    "@odd-design-system/design-tokens": "workspace:*",
    "@odd-design-system/icons": "workspace:*",
    "@odd-design-system/ui-components": "workspace:*",
    "@supabase/supabase-js": "^2.86.2",
    "@tamagui/config": "^1.138.6",
    "@tamagui/linear-gradient": "^1.138.6",
    "@tamagui/lucide-icons": "^1.138.6",
    "@tamagui/react-native-media-driver": "^1.138.6",
    "@tamagui/shorthands": "^1.138.6",
    "@tamagui/themes": "^1.138.6",
    "@tamagui/toast": "^1.138.6",
    "@vxrn/color-scheme": "^1.2.20",
    "dotenv": "^17.2.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.1.7",
    "ffmpeg-static": "^5.3.0",
    "libphonenumber-js": "^1.12.31",
    "lottie-react": "^2.4.1",
    "pdfkit": "^0.17.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-svg": "^15.15.1",
    "react-native-svg-web": "^1.0.9",
    "react-native-web": "^0.21.2",
    "tamagui": "^1.138.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.24.2",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
