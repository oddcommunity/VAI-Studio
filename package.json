{
  "name": "vai-studio",
  "version": "3.0.1",
  "description": "VAI Studio - Test and compare Speech-to-Text models locally",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild": "./scripts/generate-build-info.sh && ./scripts/prepare-python-bundle.sh",
    "build": "npm run prebuild && electron-builder",
    "build:mac": "npm run prebuild && electron-builder --mac",
    "build:win": "npm run prebuild && electron-builder --win",
    "build:linux": "npm run prebuild && electron-builder --linux",
    "build:all": "npm run prebuild && electron-builder --mac --win --linux"
  },
  "keywords": [
    "speech-to-text",
    "whisper",
    "voxtral",
    "transcription",
    "electron",
    "ai",
    "stt",
    "transcription-tool"
  ],
  "author": "VAI Studio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oddcommunity/VAI-Studio"
  },
  "build": {
    "appId": "com.vaistudio.app",
    "productName": "VAI Studio",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/*.node",
      "backends-bundle/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "backends/**/*.py",
      "!backends/__pycache__",
      "!backends/*.pyc",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backends-bundle",
        "to": "backends",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      },
      {
        "from": "test_audio.wav",
        "to": "test_audio.wav"
      },
      {
        "from": "scripts/python-wrapper.sh",
        "to": "scripts/python-wrapper.sh"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "type": "distribution"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "oddcommunity",
      "repo": "VAI-Studio"
    }
  },
  "dependencies": {
    "@odd-core/api": "link:/root/odd-core/packages/api",
    "@odd-core/auth": "link:/root/odd-core/packages/auth",
    "@odd-core/crypto": "link:/root/odd-core/packages/crypto",
    "@odd-core/feature-flags": "link:/root/odd-core/packages/feature-flags",
    "@odd-core/license": "link:/root/odd-core/packages/license",
    "@odd-core/log": "link:/root/odd-core/packages/log",
    "@odd-core/notifications": "link:/root/odd-core/packages/notifications",
    "@odd-core/storage": "link:/root/odd-core/packages/storage",
    "@odd-core/telemetry": "link:/root/odd-core/packages/telemetry",
    "@odd-core/types": "link:/root/odd-core/packages/types",
    "@odd-core/validation": "link:/root/odd-core/packages/validation",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.1.7",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  }
}
