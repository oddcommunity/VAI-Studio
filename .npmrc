approved-builds=["electron","ffmpeg-static","electron-winstaller"]
onlyBuiltDependencies:
  - electron

# Critical fix for electron-builder + pnpm
# Without this, transitive deps like ajv don't get bundled into app.asar
node-linker=hoisted

# Don't auto-install peer deps (some like @silero/vad don't exist on npm)
auto-install-peers=false

# Hoist packages needed by Electron main process
public-hoist-pattern[]=@supabase/*
node-options="--max-old-space-size=16384"
